  /* ---------- altitude tape ---------- */
  const TOP = 80000, PX = 300;          // scale ends at 80,000 ft; 30 px for each 100 ft
  const strip = $('#tapeStrip'), tapeWin = $('#tapeWin');
  (() => {
    let html = '';
    for (let v = 0; v <= TOP; v += 100) {
      const y = (TOP - v) / 1000 * PX;
      html += '<i class="m" style="top:' + (y + PX / 20) + 'px"></i><i style="top:' + y + 'px"></i><span style="top:' + y + 'px">' + String(v % 1000).padStart(3, '0') + '</span>';
    }
    strip.innerHTML = html;
    strip.style.height = (TOP / 1000 * PX) + 'px';
  })();

  /* ---------- vertical speed scale: follows how fast the page descends ---------- */
  const vsiEl = $('#vsi'), vsiBar = $('#vsiBar'), vsiBox = $('#vsiBox');
  const VSC = [[0, 0], [0.5, 0.2], [1, 0.38], [2, 0.58], [3, 0.75], [4, 0.9]];
  const vsFrac = (k) => { k = Math.min(4, k); for (let i = 1; i < VSC.length; i++) if (k <= VSC[i][0]) { const a = VSC[i - 1], b = VSC[i]; return a[1] + (b[1] - a[1]) * (k - a[0]) / (b[0] - a[0]); } return 0.9; };
  let vsAlt = null, vsT = 0, vs = 0, vsShown = -1;
  function vsTick(t) {
    requestAnimationFrame(vsTick);
    if (innerWidth < 1100 || !marks.length) return;
    const a = Math.max(0, altitudeAt(scrollY + innerHeight * 0.5));
    if (vsAlt !== null && t > vsT) {
      const raw = clamp((a - vsAlt) / ((t - vsT) / 1000) * 0.5, -4000, 4000);   // scaled so a steady scroll reads about 1,000 to 3,000 ft/min
      vs += (raw - vs) * 0.12;
