<script>
(() => {
  'use strict';
  const root = document.documentElement;
  root.classList.add('js');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const $ = (s) => document.querySelector(s);
  const IMG = {{ u2base | json }}, CART = { root: {{ routes.root_url | json }}, u2: {{ u2var.id | default: "null" }}, ton: {{ u2ton | default: "null" }}, hub: {{ u2hub | default: "null" }}, add: { ton: [{{ u2ton | default: "null" }}], bealem: [{{ u2ba | default: "null" }}], bealer: [{{ u2bb | default: "null" }}], hub: [{{ u2hub | default: "null" }}] }, price: {{ product.price | money | strip_html | json }} };
  const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
  let vh = innerHeight, vw = innerWidth;

  /* ---------- gallery: the in-sim shots ---------- */
  const SHOTS = [
    ['c_9', 'The U-2S from above, with superpods and the dorsal antenna, over cloud'],
    ['c_4', 'The U-2S on the ramp with the crew van and a ground cart'],
    ['c_11', 'The U-2S in silhouette against the sun at high altitude'],
    ['c_2', 'The pilot in the yellow pressure suit, with the curve of the earth outside'],
    ['c_5', 'The U-2S cockpit from above: yoke, three displays and the keypad'],
    ['c_6', 'Head-on view of the U-2S in flight'],
    ['c_3', 'The U-2S from directly above, low over the desert'],
    ['c_1', 'Close view of the fuselage with chalk art behind the cockpit'],
    ['c_8', 'The cockpit on the ground with the canopy open and the tablet fitted'],
    ['c_10', 'The U-2S in level flight with a rocket trail in the distance'],
    ['c_12', 'The U-2S parked outside the hangars at Groom Lake'],
    ['c_7', 'A U-2S outside the hangar at RAF Fairford, under a rainbow'],
    ['c_13', 'Transport aircraft on the ramp at one of the included sceneries'],
    ['x_sc3', 'Included scenery: the U-2S on the ramp in front of the hangars'],
    ['x_sc4', 'Included scenery: two U-2S aircraft on the ramp, seen from above'],
    ['x_sc1', 'Included scenery: a passenger jet and a fuel truck on the ramp'],
    ['x_sc2', 'Included scenery: a hangar with a rainbow behind it'],
    ['x_sc5', 'Included scenery: the hangar line and a fuel trailer'],
    [7, 'The U-2S banking over desert and cloud with superpods fitted'],
    [6, 'The U-2S with the dorsal SPAN antenna, high over a mountain range'],
    [2, "Pilot's view of the U-2S cockpit above a deck of clouds"],
    [3, 'The U-2S in silhouette against a sunset band at altitude'],
    [4, 'The wing and the curve of the earth seen through the canopy'],
    [5, 'The cockpit at dawn with the EFB tablet and the lit displays'],
    [9, 'Head-on view of the U-2S with the pilot under the canopy'],
    [8, 'The U-2S from below, seen through frost on the glass'],
    [10, 'The U-2S over a carrier group at sea'],
    [1, 'The U-2S low over a tree line with the gear down on final']
  ];
  const file = (n) => IMG + '' + (typeof n === 'number' ? 'shot_' + n : n);
  const thumbs = $('#thumbs'), mediaImg = $('#mediaImg');
  let cur = 0;
  SHOTS.forEach(([n, alt], i) => {
    const b = document.createElement('button');
    b.type = 'button';
    b.setAttribute('aria-label', 'Show picture ' + (i + 1) + ': ' + alt);
    b.setAttribute('aria-current', String(i === 0));
    b.innerHTML = '<img src="' + file(n) + '_t.webp" loading="lazy" alt="">';
    b.addEventListener('click', () => showShot(i));
    thumbs.appendChild(b);
  });
  function showShot(i) {
    cur = (i + SHOTS.length) % SHOTS.length;
    mediaImg.src = file(SHOTS[cur][0]) + '.webp';
    mediaImg.alt = SHOTS[cur][1];
    Array.from(thumbs.children).forEach((b, k) => b.setAttribute('aria-current', String(k === cur)));
    const tb = thumbs.children[cur]; if (tb) thumbs.scrollTo({ left: tb.offsetLeft - thumbs.clientWidth / 2 + tb.clientWidth / 2, behavior: 'smooth' });
  }
  const lb = $('#lb'), lbImg = $('#lbImg'), lbCap = $('#lbCap');
  function lbShow(i) {
    showShot(i);
    lbImg.src = file(SHOTS[cur][0]) + '.webp'; lbImg.alt = SHOTS[cur][1];
    lbCap.textContent = (cur + 1) + ' / ' + SHOTS.length + '  ' + SHOTS[cur][1];
  }
  $('#mediaMain').addEventListener('click', () => {
    $('#lbPrev').hidden = $('#lbNext').hidden = false;
    lbShow(cur);
    if (typeof lb.showModal === 'function') lb.showModal();
  });
  $('#lbPrev').addEventListener('click', () => lbShow(cur - 1));
  $('#lbNext').addEventListener('click', () => lbShow(cur + 1));
  $('#lbClose').addEventListener('click', () => lb.close());
  lb.addEventListener('click', (e) => {
    if (e.target.closest('button')) return;                       // Previous, Next and Close do their own work
    const im = $('#lbImg');
    if (e.target === im && im.naturalWidth) {                     // the picture box is larger than the picture: find the visible picture
      const r = im.getBoundingClientRect(), k = Math.min(r.width / im.naturalWidth, r.height / im.naturalHeight);
      const w = im.naturalWidth * k, h = im.naturalHeight * k, x = r.left + (r.width - w) / 2, y = r.top + (r.height - h) / 2;
      if (e.clientX >= x && e.clientX <= x + w && e.clientY >= y && e.clientY <= y + h) return;
    }
    lb.close();
  });
  lb.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') lbShow(cur - 1); if (e.key === 'ArrowRight') lbShow(cur + 1); });

  /* ---------- hero title: the logo, SPYPLANE and the simulator line get the same width as the ink of "U-2" ---------- */
  (() => {
    const lock = $('.lockup'), big = $('.lockup .big'), sub = $('.lockup .sub'); if (!lock || !big || !sub) return;
    const fit = () => {
      try {
        const c = document.createElement('canvas').getContext('2d');
        const bs = getComputedStyle(big), ss = getComputedStyle(sub);
        c.font = bs.fontWeight + ' ' + bs.fontSize + ' ' + bs.fontFamily;
        const m = c.measureText('U-2'), ls = parseFloat(bs.letterSpacing) || 0;
        const inkL = -m.actualBoundingBoxLeft, inkR = big.getBoundingClientRect().width - (m.actualBoundingBoxRight + 2 * ls);
        c.font = ss.fontWeight + ' ' + ss.fontSize + ' ' + ss.fontFamily;
        const s1 = c.measureText('S'), e1 = c.measureText('E');
        sub.style.paddingLeft = Math.max(0, inkL + s1.actualBoundingBoxLeft) + 'px';
        sub.style.paddingRight = Math.max(0, inkR - (e1.width - e1.actualBoundingBoxRight)) + 'px';
