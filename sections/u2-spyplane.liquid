    ['USAF-801070-WR', 'USAF 80-1070 WR'], ['USAF-801076', 'USAF 80-1076'], ['USAF-801077', 'USAF 80-1077'],
    ['USAF-801085', 'USAF 80-1085'], ['USAF-801087', 'USAF 80-1087'], ['USAF-801092', 'USAF 80-1092'], ['USAF-801094', 'USAF 80-1094'],
    ['USAF-801096', 'USAF 80-1096'], ['USAF-6810329', 'USAF 68-10329'], ['USAF-6810331', 'USAF 68-10331'], ['USAF-6810337', 'USAF 68-10337'],
