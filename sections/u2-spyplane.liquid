  const PAGES = { PFD: 'scr_mfd_pfd', EFA: 'scr_mfd_efa', PERF: 'scr_mfd_perf', INIT: 'scr_mfd_init', ICAW: 'scr_mfd_icaw' };
  const NAMES = { PFD: 'the primary flight display', EFA: 'the electronic flight aid checklist page', PERF: 'the PERF engine and fuel page', INIT: 'the INS initialization page', ICAW: 'the caution and warning page' };
  function show(scr, page, animate) {
