    vsShown = shown;
    const f = vsFrac(Math.abs(shown) / 1000) * 50, down = shown < 0;
    vsiBar.style.top = (down ? 50 : 50 - f) + '%'; vsiBar.style.height = f + '%';
    vsiBox.style.top = (50 + (down ? f : -f)) + '%';
