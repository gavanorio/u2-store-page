    for (let i = 1; i < marks.length; i++) {
      if (y <= marks[i].y) {
        const a = marks[i - 1], b = marks[i];
        return a.alt + (b.alt - a.alt) * clamp((y - a.y) / Math.max(1, b.y - a.y), 0, 1);
      }
    }
    return marks[marks.length - 1].alt;
  }

  /* ---------- measure ---------- */
  const tops = {};
  const hero = $('#top'), bar = $('#bar');
  const chapters = Array.from(document.querySelectorAll('.chapter img'));
  function measure() {
    vh = innerHeight; vw = innerWidth;
    marks = Array.from(document.querySelectorAll('[data-alt]'))
      .map((el) => ({ y: el.getBoundingClientRect().top + scrollY, alt: +el.dataset.alt }))
