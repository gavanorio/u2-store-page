{%- comment -%} U-2 Spyplane product page. Made from the prototype with build_shopify.py. Pictures are in Content > Files, names start with "u2s_". {%- endcomment -%}
{%- liquid
  assign u2probe = 'u2s_c_9.webp'
  assign u2base = u2probe | file_url | split: 'c_9.webp' | first
  assign u2var = product.selected_or_first_available_variant
  assign u2ton = section.settings.tonopah.selected_or_first_available_variant.id
  assign u2hub = section.settings.hub.selected_or_first_available_variant.id
  assign u2ba = section.settings.beale_a.selected_or_first_available_variant.id
  assign u2bb = section.settings.beale_b.selected_or_first_available_variant.id
  assign u2bsum = section.settings.beale_a.price | plus: section.settings.beale_b.price
-%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap">
<style>
.u2p {
  color-scheme: light;
  --paper: #ffffff;
  --mist: #f2f2f2;
  --char: #272727;          
  --deep: #151515;
  --ink: #1f1f1f;
  --mute: rgba(39, 39, 39, .7);
  --line: rgba(39, 39, 39, .12);
  --on-dark: rgba(255, 255, 255, .74);
  --line-dark: rgba(255, 255, 255, .14);
  --mfd: #43d36f;           
  --amber: #f3a43b;         
  --cyan: #66cbe0;
  --brass: #c8a46a;         
  --red: #e5322d;           
  --ok: #2fae5b;
  --sans: "Jost", "Futura", "Century Gothic", "Segoe UI", system-ui, sans-serif;
  --data: "Jost", "Futura", "Century Gothic", "Segoe UI", system-ui, sans-serif;   
  --gut-l: max(16px, env(safe-area-inset-left, 0px));
  --gut-r: max(16px, env(safe-area-inset-right, 0px));
  --tape: 0px;
}
@media (min-width: 1100px) {
.u2p { --tape: 150px; }
}
.u2p, .u2p *, .u2p *::before, .u2p *::after { box-sizing: border-box; }
@media (prefers-reduced-motion: reduce) {

}
.u2p { margin: 0; background: var(--paper); color: var(--ink); font: 400 17px/1.65 var(--sans); -webkit-font-smoothing: antialiased; overflow-x: clip; }
.u2p img { max-width: 100%; height: auto; }
.u2p a { color: inherit; }
.u2p :focus-visible { outline: 2px solid currentColor; outline-offset: 3px; border-radius: 4px; }
.u2p h1, .u2p h2, .u2p h3 { margin: 0; font-family: var(--sans); text-wrap: balance; }
.u2p h2 { font-size: clamp(30px, 3.7vw, 54px); line-height: 1.02; font-weight: 700; text-transform: uppercase; letter-spacing: .01em; }
.u2p h3 { font-size: 19px; line-height: 1.25; font-weight: 600; }
.u2p p { margin: 0; }
.u2p .wrap { width: 100%; max-width: 1280px; margin: 0 auto; padding-left: var(--gut-l); padding-right: var(--gut-r); }
.u2p .u2main { padding-right: var(--tape); }
.u2p .bleed { margin-right: calc(var(--tape) * -1); }
.u2p .bleed .wrap { padding-right: calc(var(--gut-r) + var(--tape)); max-width: calc(1280px + var(--tape)); }
.u2p .eyebrow { display: flex; align-items: center; gap: 12px; font: 500 12.5px/1.3 var(--sans); letter-spacing: .2em; text-transform: uppercase; color: var(--mute); }
.u2p .eyebrow .fl { font: 700 11.5px/1 var(--data); letter-spacing: .1em; padding: 6px 8px; border: 1px solid currentColor; border-radius: 4px; }
.u2p .dark .eyebrow { color: var(--on-dark); }
.u2p .lede { font-size: clamp(17px, 1.4vw, 19.5px); line-height: 1.65; color: var(--mute); max-width: 62ch; }
.u2p .dark .lede { color: var(--on-dark); }
.u2p .small { font-size: 14px; color: var(--mute); }
.u2p .dark { background: var(--char); color: #fff; }
.u2p .sec { position: relative; padding-block: clamp(72px, 10vw, 140px); }
.u2p .mk { display: block; height: 0; }
.u2p .btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 10px; cursor: pointer; text-decoration: none;
  font: 700 14px/1 var(--sans); letter-spacing: .02em; padding: 17px 32px; border-radius: 10px; border: 1px solid transparent;
  transition: background .2s, color .2s, border-color .2s, transform .2s;
}
.u2p .btn:hover { transform: translateY(-1px); }
.u2p .btn-dark { background: var(--char); color: #fff; }
.u2p .btn-dark:hover { background: #000; }
.u2p .btn-light { background: #fff; color: var(--char); }
.u2p .btn-light:hover { background: var(--mist); }
.u2p .btn-line { border-color: currentColor; background: transparent; }
.u2p .btn-block { width: 100%; }
.u2p .bar { position: fixed; top: 0; left: 0; right: 0; z-index: 40; padding-top: env(safe-area-inset-top, 0px); color: #fff; transition: background .3s, box-shadow .3s; }
.u2p .bar::before { content: ""; position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(0, 0, 0, .45), transparent); pointer-events: none; transition: opacity .3s; }
.u2p .bar.solid { background: var(--char); box-shadow: 0 1px 0 rgba(255, 255, 255, .06); }
.u2p .bar.solid::before { opacity: 0; }
.u2p .bar-in { position: relative; display: flex; align-items: center; gap: 28px; height: 66px; padding-left: var(--gut-l); padding-right: var(--gut-r); }
.u2p .logo { display: flex; align-items: center; }
.u2p .logo img { height: 19px; width: auto; display: block; }
.u2p .bar nav { display: flex; gap: 26px; margin: 0 auto; }
.u2p .bar nav a { text-decoration: none; font: 400 14px/1 var(--sans); opacity: .92; }
.u2p .bar nav a.b { font-weight: 700; }
.u2p .bar nav a:hover { opacity: 1; text-decoration: underline; text-underline-offset: 5px; }
.u2p .bar .btn { padding: 12px 20px; }
.u2p .alt-pill { display: none; font: 400 11.5px/1 var(--data); letter-spacing: .08em; color: var(--mfd); white-space: nowrap; font-variant-numeric: tabular-nums; }
.u2p .alt-pill b { color: #fff; }
@media (max-width: 1099px) {
.u2p .bar nav { display: none; }
.u2p .alt-pill { display: inline; margin-left: auto; }
}
@media (max-width: 400px) {
.u2p .logo img { height: 14px; }
.u2p .bar .btn { padding: 11px 14px; }
}
.u2p .tape { position: fixed; z-index: 35; top: 50%; right: calc(env(safe-area-inset-right, 0px) + 8px); transform: translateY(-46%); width: 132px; display: none; font-family: var(--data); font-variant-numeric: tabular-nums; }
@media (min-width: 1100px) {
.u2p .tape { display: block; }
}
.u2p .tape-shell { display: grid; gap: 8px; padding: 10px 8px 10px 16px; border-radius: 10px; overflow: hidden; border: 1px solid rgba(255,255,255,.35); box-shadow: 0 6px 22px rgba(0,0,0,.28);
  background: linear-gradient(to bottom, #4a97e6 0, #5aa2ea calc(50% - 1px), #fff calc(50% - 1px), #fff calc(50% + 1px), #c2364f calc(50% + 1px), #a92c45 100%); }
.u2p .tape-head { font-size: 15px; font-weight: 600; letter-spacing: .04em; color: #fff; text-align: center; text-shadow: 0 1px 3px rgba(0,0,0,.45); }
.u2p .tape-foot { display: grid; gap: 2px; text-align: center; text-shadow: 0 1px 3px rgba(0,0,0,.5); }
.u2p .tape-foot b { font-size: 15px; font-weight: 600; color: #fff; }
.u2p .tape-foot span { font-size: 9.5px; font-weight: 700; letter-spacing: .14em; color: #fff; min-height: 2.5em; line-height: 1.25; }
.u2p .tape-row { display: grid; grid-template-columns: 62px 34px; gap: 10px; align-items: center; }
.u2p .tape-frame { position: relative; }
.u2p .tape-win { position: relative; height: min(48vh, 430px); overflow: hidden; background: rgba(70, 66, 104, .86); border: 2px solid #fff; border-radius: 2px; }
.u2p .tape-strip { position: absolute; left: 0; right: 0; top: 0; will-change: transform; }
.u2p .tape-strip i { position: absolute; left: 0; height: 2px; width: 11px; margin-top: -1px; background: #fff; }
.u2p .tape-strip i.m { width: 6px; height: 1.5px; opacity: .85; }
.u2p .tape-strip span { position: absolute; right: 7px; font-size: 16px; font-weight: 400; letter-spacing: .03em; line-height: 1; transform: translateY(-50%); color: #fff; }
.u2p .tape-box { position: absolute; z-index: 2; left: -10px; right: 20px; top: 50%; transform: translateY(-50%); height: 34px; display: grid; place-items: center; background: #0d1436; border: 2px solid #fff; border-right: 0; font-size: 25px; font-weight: 600; letter-spacing: .02em; line-height: 1; color: #fff; }
.u2p .tape-drum { position: absolute; z-index: 2; right: -6px; top: 50%; transform: translateY(-50%); width: 28px; height: 54px; display: grid; align-content: center; justify-items: center; gap: 3px; background: #0d1436; border: 2px solid #fff; font-size: 13px; font-weight: 600; line-height: 1; color: #fff; overflow: hidden; }
.u2p .tape-drum span:nth-child(2) { font-size: 14px; }
.u2p .vsi { position: relative; height: min(40vh, 356px); }
.u2p .vsi svg { position: absolute; inset: 0; width: 100%; height: 100%; }
.u2p .vsi svg polygon { fill: rgba(70, 66, 104, .86); stroke: #fff; stroke-width: 2; vector-effect: non-scaling-stroke; }
.u2p .vsi em { position: absolute; left: 9px; font: 400 11.5px/1 var(--data); font-style: normal; color: #fff; transform: translateY(-50%); }
.u2p .vsi em::before { content: ""; position: absolute; left: -9px; top: 50%; width: 5px; height: 1.5px; margin-top: -1px; background: #fff; }
.u2p .vsi-bar { position: absolute; left: 2px; width: 5px; background: #fff; top: 50%; height: 0; }
.u2p .vsi-box { position: absolute; z-index: 2; left: 9px; right: -4px; top: 50%; transform: translateY(-50%); height: 19px; display: grid; place-items: center; background: #fff; color: #0d1436; border: 1px solid #0d1436; font: 600 12px/1 var(--data); letter-spacing: .04em; }
.u2p .hero { position: relative; height: clamp(600px, 94vh, 1000px); overflow: hidden; color: #fff; background: #0b1626; }
.u2p .hero-img { position: absolute; inset: -4% 0 0; width: 100%; height: 108%; object-fit: cover; object-position: 66% 42%; transform: translate3d(0, var(--hy, 0px), 0) scale(var(--hs, 1.04)); will-change: transform; }
.u2p .hero-shade { position: absolute; inset: 0; background:
  linear-gradient(to right, rgba(5, 12, 26, .86) 0%, rgba(5, 12, 26, .55) 34%, rgba(5, 12, 26, 0) 62%),
  linear-gradient(to bottom, rgba(5, 12, 26, .5) 0%, transparent 30%, transparent 62%, rgba(5, 12, 26, .72) 100%); }
.u2p .hero-in { position: relative; z-index: 1; height: 100%; display: grid; align-content: center; gap: 22px; padding-top: 70px; }
.u2p .kicker { font: 500 13px/1.3 var(--sans); letter-spacing: .24em; text-transform: uppercase; color: rgba(255, 255, 255, .86); }
.u2p .hero-title { display: grid; line-height: .82; text-transform: uppercase; }
.u2p .hero-title .big { font-size: clamp(108px, 17vw, 270px); font-weight: 800; letter-spacing: -.025em; animation: u2p-rise 1.3s cubic-bezier(.2, .7, .1, 1) both; }
.u2p .hero-title .sub { font-size: clamp(22px, 3vw, 44px); font-weight: 500; letter-spacing: .42em; margin-top: 18px; animation: u2p-track 1.7s cubic-bezier(.2, .7, .1, 1) both; }
@keyframes u2p-rise { from { transform: translateY(16px); } to { transform: none; } }
@keyframes u2p-track { from { letter-spacing: .7em; } to { letter-spacing: .42em; } }
.u2p .hero-tag { font-size: clamp(18px, 1.6vw, 22px); max-width: 30ch; color: rgba(255, 255, 255, .9); }
.u2p .hero .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
.u2p .hero-facts { position: absolute; z-index: 1; left: 0; right: 0; bottom: 0; }
.u2p .facts-row { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); border-top: 1px solid rgba(255, 255, 255, .22); padding-block: 18px 26px; }
.u2p .facts-row > div { display: grid; gap: 2px; min-width: 0; }
.u2p .facts-row dt { font: 500 11px/1.3 var(--sans); letter-spacing: .18em; text-transform: uppercase; color: rgba(255, 255, 255, .72); }
.u2p .facts-row dd { margin: 0; font: 700 clamp(18px, 2vw, 27px)/1.15 var(--data); font-variant-numeric: tabular-nums; }
.u2p .facts-row dd small { font-size: .5em; letter-spacing: .1em; margin-left: 4px; color: rgba(255, 255, 255, .72); }
@media (max-width: 760px) {
.u2p .hero { height: auto; min-height: 640px; }
.u2p .hero-shade { background: linear-gradient(to bottom, rgba(5, 12, 26, .62), rgba(5, 12, 26, .35) 40%, rgba(5, 12, 26, .85)); }
.u2p .hero-img { object-position: 74% 40%; }
.u2p .hero-in { height: auto; padding-top: 120px; padding-bottom: 210px; }
.u2p .facts-row { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 14px; }
.u2p .facts-row > div:last-child { grid-column: 1 / -1; }
}
.u2p .product { padding-block: clamp(40px, 6vw, 80px); }
.u2p .product-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(28px, 4vw, 64px); align-items: start; }
.u2p .product-grid > * { min-width: 0; }
@media (max-width: 900px) {
.u2p .product-grid { grid-template-columns: minmax(0, 1fr); }
}
.u2p .media-main { display: block; width: 100%; padding: 0; border: 0; background: var(--mist); border-radius: 12px; overflow: hidden; cursor: zoom-in; aspect-ratio: 1.6; }
.u2p .media-main img { display: block; width: 100%; height: 100%; object-fit: cover; transition: opacity .25s; }
.u2p .thumbs { position: relative; display: flex; gap: 10px; margin-top: 12px; overflow-x: auto; padding-bottom: 8px; scroll-snap-type: x proximity; scrollbar-color: #bbb transparent; }
.u2p .thumbs button { flex: 0 0 auto; width: 132px; scroll-snap-align: start; padding: 0; border: 2px solid transparent; border-radius: 8px; overflow: hidden; cursor: pointer; background: var(--mist); aspect-ratio: 1.6; }
.u2p .thumbs button[aria-current="true"] { border-color: var(--char); }
.u2p .thumbs img { display: block; width: 100%; height: 100%; object-fit: cover; }
.u2p .buybox { display: grid; gap: 18px; position: sticky; top: 92px; }
.u2p .vendor { font: 500 12.5px/1 var(--sans); letter-spacing: .2em; text-transform: uppercase; color: var(--mute); }
.u2p .ptitle { font-size: clamp(28px, 2.6vw, 38px); line-height: 1.15; font-weight: 500; text-transform: none; letter-spacing: 0; }
.u2p .price { display: flex; align-items: baseline; gap: 12px; }
.u2p .price .lbl { font-size: 14px; color: var(--mute); }
.u2p .price b { font-size: 22px; font-weight: 600; }
.u2p .compat { margin: 0; padding: 16px 18px; border-radius: 10px; background: var(--mist); display: grid; gap: 4px; }
.u2p .compat dt { font-weight: 600; font-size: 15px; }
.u2p .compat dd { margin: 0; font-size: 15px; color: var(--mute); display: flex; align-items: center; gap: 8px; }
.u2p .compat dd::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: #2fae5b; }
.u2p .note { font-size: 14px; color: var(--mute); background: var(--mist); border-radius: 8px; padding: 10px 14px; }
.u2p .manual { font-size: 14.5px; color: var(--mute); }
.u2p .manual a { color: var(--ink); font-weight: 600; }
.u2p .quick { list-style: none; margin: 4px 0 0; padding: 0; border-top: 1px solid var(--line); }
.u2p .quick li { display: flex; justify-content: space-between; gap: 16px; padding: 11px 0; border-bottom: 1px solid var(--line); font-size: 15px; }
.u2p .quick li span { color: var(--mute); }
.u2p .quick li b { font: 700 14.5px/1.4 var(--data); font-variant-numeric: tabular-nums; }
.u2p .badges { border-block: 1px solid var(--line); }
.u2p .badges ul { list-style: none; margin: 0 auto; padding-block: 26px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
.u2p .badges li { display: grid; grid-template-columns: 40px minmax(0, 1fr); align-items: center; gap: 14px; font: 600 13px/1.35 var(--sans); letter-spacing: .1em; text-transform: uppercase; }
.u2p .badges svg { width: 40px; height: 40px; stroke: var(--char); fill: none; stroke-width: 1.5; }
@media (max-width: 900px) {
.u2p .badges ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 480px) {
.u2p .badges ul { grid-template-columns: minmax(0, 1fr); }
}
.u2p .intro-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(28px, 5vw, 80px); }
.u2p .intro-grid > * { min-width: 0; }
.u2p .intro-copy { display: grid; gap: 18px; }
.u2p .intro-copy p { color: var(--mute); }
@media (max-width: 900px) {
.u2p .intro-grid { grid-template-columns: minmax(0, 1fr); }
}
.u2p .airframe { background: var(--mist); }
.u2p .plan-grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(28px, 4vw, 64px); align-items: center; }
.u2p .plan-grid > * { min-width: 0; }
@media (max-width: 900px) {
.u2p .plan-grid { grid-template-columns: minmax(0, 1fr); }
}
.u2p .plan-art { position: relative; margin: 0; }
.u2p .plan-art img { display: block; width: 100%; height: auto; }
.u2p .dims { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; --draw: 1; }
.u2p .dims .ln { fill: none; stroke: var(--char); stroke-width: 3; stroke-dasharray: 1; stroke-dashoffset: calc(1 - var(--draw)); }
.u2p .dims .ext { stroke: rgba(39, 39, 39, .45); stroke-width: 2; stroke-dasharray: 10 8; }
.u2p .dims text { font: 700 36px var(--data); fill: var(--char); letter-spacing: 3px; }
.u2p .dims .tag { fill: rgba(242, 242, 242, .9); }
.u2p .specs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 26px 0 0; border-top: 1px solid var(--line); }
.u2p .specs > div { padding: 13px 12px 13px 0; border-bottom: 1px solid var(--line); display: grid; gap: 2px; }
.u2p .specs dt { font: 500 11px/1.3 var(--sans); letter-spacing: .16em; text-transform: uppercase; color: var(--mute); }
.u2p .specs dd { margin: 0; font: 700 16px/1.3 var(--data); font-variant-numeric: tabular-nums; }
.u2p .chapter { position: relative; height: clamp(460px, 78vh, 860px); overflow: hidden; color: #fff; background: #0b1626; }
.u2p .chapter img { position: absolute; inset: -8% 0; width: 100%; height: 116%; object-fit: cover; transform: translate3d(0, var(--py, 0px), 0); will-change: transform; }
.u2p .chapter::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(0, 0, 0, .72), rgba(0, 0, 0, .1) 46%, transparent 70%); }
.u2p .chapter .wrap { position: relative; z-index: 1; height: 100%; display: grid; align-content: end; gap: 12px; padding-bottom: clamp(34px, 6vw, 70px); }
.u2p .chapter .eyebrow { color: rgba(255, 255, 255, .85); }
.u2p .chapter h2 { font-size: clamp(32px, 4.6vw, 70px); }
.u2p .chapter p { max-width: 52ch; color: rgba(255, 255, 255, .86); font-size: clamp(16px, 1.3vw, 19px); }
.u2p .tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 30px; border-bottom: 1px solid var(--line); padding-bottom: 14px; }
.u2p .tab { font: 600 14.5px/1 var(--sans); padding: 13px 20px; border-radius: 999px; border: 1px solid var(--line); background: #fff; color: var(--ink); cursor: pointer; }
.u2p .tab[aria-selected="true"] { background: var(--char); color: #fff; border-color: var(--char); }
.u2p .panel-f { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: clamp(28px, 4vw, 64px); align-items: center; padding-top: 36px; }
.u2p .panel-f > * { min-width: 0; }
@media (max-width: 900px) {
.u2p .panel-f { grid-template-columns: minmax(0, 1fr); }
}
.u2p .panel-f h3 { font-size: 26px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; margin-bottom: 14px; }
.u2p .panel-f ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 12px; }
.u2p .panel-f li { position: relative; padding-left: 22px; color: var(--mute); font-size: 16px; }
.u2p .panel-f li::before { content: ""; position: absolute; left: 0; top: .72em; width: 9px; height: 2px; background: var(--char); }
.u2p .panel-f figure { margin: 0; }
.u2p .panel-f figure img { display: block; width: 100%; height: auto; border-radius: 12px; }
.u2p .panel-f figure.screen { display: grid; place-items: center; background: var(--deep); border-radius: 12px; padding: 22px; }
.u2p .panel-f figure.screen img { width: auto; max-height: 460px; border-radius: 4px; }
.u2p .panel-f figure.plate img { background: var(--mist); }
.u2p .panel-f figcaption { font-size: 13.5px; color: var(--mute); margin-top: 10px; }
.u2p .panel-f figure.screen figcaption { color: var(--on-dark); }
.u2p .cockpit { background: var(--deep); color: #fff; }
.u2p .cockpit-head { display: grid; gap: 18px; max-width: 760px; }
.u2p .panel { position: relative; max-width: 1180px; margin: clamp(36px, 6vw, 64px) auto 0; }
.u2p .panel > img { display: block; width: 100%; height: auto; }
.u2p .scr { position: absolute; overflow: hidden; background: #000; border-radius: 3px; cursor: pointer; border: 0; padding: 0; }
