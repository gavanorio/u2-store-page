    altDrum.innerHTML = '<span>' + p2(tens + 10) + '</span><span>' + p2(tens) + '</span><span>' + p2(tens - 10) + '</span>';
    tapeFL.textContent = 'FL' + String(Math.round(shownAlt / 100)).padStart(3, '0');
    altPill.textContent = shownAlt.toLocaleString('en-US');
