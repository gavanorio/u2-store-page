{%- comment -%} U-2 Spyplane video hero for the home page. Video and picture are in Content > Files. {%- endcomment -%}
{%- liquid
  assign p = section.settings.product
  assign vid = section.settings.video_file | default: 'u2s_hero.mp4' | file_url
  assign poster = section.settings.poster_file | default: 'u2s_c_9.webp' | file_url
  assign link = p.url | default: section.settings.fallback_url
-%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700;800&display=swap">
<style>
.u2h { position: relative; display: grid; align-items: center; width: 100%; max-width: 100vw; min-width: 0; contain: inline-size; min-height: clamp(520px, {{ section.settings.height }}vh, 920px); overflow: hidden; background: #000; color: #fff; font-family: "Jost", system-ui, sans-serif; text-align: left; isolation: isolate; }
.u2h *, .u2h *::before, .u2h *::after { box-sizing: border-box; }
.u2h-bg, .u2h-bg img, .u2h-bg video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.u2h-bg video { opacity: 0; transition: opacity 1.1s; }
.u2h-bg.play video { opacity: 1; }
.u2h-shade { position: absolute; inset: 0; z-index: 1; pointer-events: none;
  background: radial-gradient(120% 90% at 50% 45%, rgba(0,0,0,0) 35%, rgba(0,0,0,.62) 100%), linear-gradient(90deg, rgba(0,0,0,.66) 0%, rgba(0,0,0,.28) 46%, rgba(0,0,0,0) 72%), linear-gradient(to top, rgba(0,0,0,.72) 0%, rgba(0,0,0,0) 34%); }
.u2h-in { position: relative; z-index: 2; width: 100%; max-width: 1280px; margin: 0 auto; padding: 72px clamp(18px, 4.5vw, 56px) 96px; display: grid; gap: 22px; justify-items: start; }
.u2h-tag { display: inline-flex; align-items: center; gap: 8px; font: 700 11.5px/1 "Jost", sans-serif; letter-spacing: .12em; text-transform: uppercase; background: #e5322d; color: #fff; padding: 7px 10px; border-radius: 4px; }
.u2h-tag i { width: 7px; height: 7px; border-radius: 50%; background: #fff; animation: u2h-blink 1.6s infinite; }
@keyframes u2h-blink { 50% { opacity: .25; } }
.u2h-lock { display: inline-grid; width: max-content; max-width: 100%; margin: 0; font-size: clamp(92px, 15vw, 230px); line-height: .82; font-weight: 800; letter-spacing: -.025em; text-transform: uppercase; color: #fff; text-shadow: 0 6px 40px rgba(0,0,0,.35); }
.u2h-lock b { font-weight: 800; }
.u2h-lock span { display: flex; justify-content: space-between; width: 0; min-width: 100%; margin-top: .34em; font-size: .225em; font-weight: 600; letter-spacing: 0; line-height: 1; }
.u2h-lock span i { font-style: normal; }
.u2h-sub { margin: 0; max-width: 46ch; font-size: clamp(16px, 1.35vw, 19px); line-height: 1.5; color: rgba(255,255,255,.86); }
.u2h-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 14px; }
.u2h-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 26px; border-radius: 6px; font: 600 15px/1 "Jost", sans-serif; text-decoration: none; border: 1px solid transparent; cursor: pointer; transition: background .15s, color .15s; }
.u2h-btn.w { background: #fff; color: #101010; } .u2h-btn.w:hover { background: #e9e9e9; }
.u2h-btn.o { border-color: rgba(255,255,255,.7); color: #fff; background: rgba(0,0,0,.18); } .u2h-btn.o:hover { background: rgba(255,255,255,.16); }
.u2h-price { font: 700 20px/1 "Jost", sans-serif; color: #fff; display: inline-flex; align-items: baseline; gap: 8px; }
.u2h-price s { font-weight: 400; font-size: 15px; color: rgba(255,255,255,.6); }
.u2h-foot { position: absolute; z-index: 2; left: 0; right: 0; bottom: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px clamp(22px, 5vw, 72px); padding: 16px 18px 20px; border-top: 1px solid rgba(255,255,255,.16); font: 600 11px/1.3 "Jost", sans-serif; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.78); }
.u2h-foot b { color: #fff; font-weight: 700; margin-left: 6px; letter-spacing: .02em; font-size: 14px; }
.u2h [hidden] { display: none !important; }
@media (max-width: 760px) {
  .u2h { min-height: clamp(500px, 82vh, 760px); }
  .u2h-shade { background: radial-gradient(130% 90% at 50% 40%, rgba(0,0,0,.1) 30%, rgba(0,0,0,.66) 100%), linear-gradient(to top, rgba(0,0,0,.8) 0%, rgba(0,0,0,0) 46%); }
  .u2h-in { justify-items: center; text-align: center; padding: 56px 18px 118px; gap: 18px; }
  .u2h-lock { font-size: clamp(92px, 31vw, 180px); }
  .u2h-row { justify-content: center; }
  .u2h-btn { flex: 1 1 100%; }
  .u2h-foot { gap: 6px 18px; font-size: 10px; } .u2h-foot b { font-size: 12.5px; }
}
@media (prefers-reduced-motion: reduce) { .u2h-tag i { animation: none; } }
</style>
<div class="u2h" id="u2h-{{ section.id }}" data-t0="{{ section.settings.release_utc | escape }}">
  <div class="u2h-bg" aria-hidden="true">
    <img src="{{ poster }}" alt="" width="1760" height="1120" loading="eager" fetchpriority="high">
    <video muted loop playsinline preload="metadata" data-src="{{ vid }}" tabindex="-1" disablepictureinpicture></video>
  </div>
  <div class="u2h-shade" aria-hidden="true"></div>
  <div class="u2h-in">
    <span class="u2h-tag"><i aria-hidden="true"></i><span data-tag data-before="{{ section.settings.tag_before | escape }}" data-after="{{ section.settings.tag_after | escape }}">{{ section.settings.tag_before | escape }}</span></span>
    <h2 class="u2h-lock" aria-label="U-2 Spyplane"><b aria-hidden="true">U-2</b><span aria-hidden="true"><i>S</i><i>P</i><i>Y</i><i>P</i><i>L</i><i>A</i><i>N</i><i>E</i></span></h2>
    {%- if section.settings.text != blank -%}<p class="u2h-sub">{{ section.settings.text | escape }}</p>{%- endif -%}
    <div class="u2h-row">
      <a class="u2h-btn w" href="{{ link }}">{{ section.settings.button | escape }}</a>
      {%- if section.settings.trailer_url != blank -%}<a class="u2h-btn o" href="{{ section.settings.trailer_url }}" target="_blank" rel="noopener">{{ section.settings.trailer_label | escape }}</a>{%- endif -%}
      {%- if p != blank and section.settings.show_price -%}
        <span class="u2h-price" data-price hidden>{{ p.price | money }}{% if p.compare_at_price > p.price %} <s>{{ p.compare_at_price | money }}</s>{% endif %}</span>
      {%- endif -%}
    </div>
  </div>
  <div class="u2h-foot" aria-hidden="true">
    <span>Cruise altitude<b>74,000+ ft</b></span><span>Wingspan<b>103 ft</b></span><span>Endurance<b>14+ hours</b></span><span>For<b>MSFS 2024</b></span>
  </div>
</div>
<script>
(() => {
  const root = document.getElementById('u2h-{{ section.id }}'); if (!root) return;
  // video: starts by itself with no sound; the picture shows until the first frame plays
  const bg = root.querySelector('.u2h-bg'), v = root.querySelector('video');
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (v && !calm && v.dataset.src) {
    v.muted = true; v.defaultMuted = true;
    v.addEventListener('playing', () => bg.classList.add('play'), { once: true });
    v.addEventListener('error', () => v.remove(), { once: true });
    const start = () => { v.src = v.dataset.src; const p = v.play(); if (p && p.catch) p.catch(() => {}); };
    if ('IntersectionObserver' in window) { const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { io.disconnect(); start(); } }); io.observe(root); } else start();
  }
  // title: SPYPLANE gets the same width as the ink of "U-2"
  const big = root.querySelector('.u2h-lock b'), sub = root.querySelector('.u2h-lock span');
  const fit = () => { try {
    const c = document.createElement('canvas').getContext('2d'), bs = getComputedStyle(big), ss = getComputedStyle(sub);
    c.font = bs.fontWeight + ' ' + bs.fontSize + ' ' + bs.fontFamily;
    const m = c.measureText('U-2'), ls = parseFloat(bs.letterSpacing) || 0;
    const inkL = -m.actualBoundingBoxLeft, inkR = big.getBoundingClientRect().width - (m.actualBoundingBoxRight + 2 * ls);
    c.font = ss.fontWeight + ' ' + ss.fontSize + ' ' + ss.fontFamily;
    const s1 = c.measureText('S'), e1 = c.measureText('E');
    sub.style.paddingLeft = Math.max(0, inkL + s1.actualBoundingBoxLeft) + 'px';
    sub.style.paddingRight = Math.max(0, inkR - (e1.width - e1.actualBoundingBoxRight)) + 'px';
  } catch (e) {} };
  fit(); addEventListener('resize', fit); if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
  // release state: the tag text changes and the price shows at the release time
  const tag = root.querySelector('[data-tag]'), price = root.querySelector('[data-price]');
  const t0 = Date.parse(root.dataset.t0);
  const tick = () => {
    const out = !t0 || Date.now() >= t0;
    if (tag) tag.textContent = out ? tag.dataset.after : tag.dataset.before;
    if (price) price.hidden = !out;
    if (!out) setTimeout(tick, Math.min(30000, t0 - Date.now() + 500));
  };
  tick();
})();
</script>
{% schema %}
{
  "name": "U-2 video hero",
  "tag": "section",
  "class": "u2h-section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "url", "id": "fallback_url", "label": "Link if no product is selected" },
    { "type": "text", "id": "video_file", "label": "Video file name in Content > Files", "default": "u2s_hero.mp4" },
    { "type": "text", "id": "poster_file", "label": "Picture file name (shows before the video)", "default": "u2s_c_9.webp" },
    { "type": "range", "id": "height", "label": "Height (percent of the window)", "min": 50, "max": 100, "step": 2, "default": 84 },
    { "type": "text", "id": "release_utc", "label": "Release time (UTC)", "default": "2026-11-13T14:00:00Z", "info": "Before this time the tag shows the first text and the price is hidden." },
    { "type": "text", "id": "tag_before", "label": "Tag text before the release", "default": "Releases today · 14:00Z" },
    { "type": "text", "id": "tag_after", "label": "Tag text after the release", "default": "Out now" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Some call it the hardest aircraft in the world to fly. Climb to the edge of space in the Miltech Simulations U-2S for Microsoft Flight Simulator 2024." },
    { "type": "text", "id": "button", "label": "Button text", "default": "Get the U-2" },
    { "type": "checkbox", "id": "show_price", "label": "Show the price after the release", "default": true },
    { "type": "text", "id": "trailer_label", "label": "Second button text", "default": "Watch the trailer" },
    { "type": "url", "id": "trailer_url", "label": "Second button link" }
  ],
  "presets": [{ "name": "U-2 video hero" }]
}
{% endschema %}
